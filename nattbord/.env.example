ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-haiku-5-5
CALENDAR=demo            # demo | google
GOOGLE_CALENDAR_ID=      # for en vanlig Gmail-kalender: e-postadressen din
GOOGLE_KEY_FILE=service-account.json
AUDIO_IN=device          # device | laptop
AUDIO_OUT=device         # device | laptop
TTS_VOICE=Nora
TTS_RATE=190
MIC_THRESHOLD=2500
EVENING_TIME=22:30
# SERIAL_PORT=/dev/cu.usbmodem1101   # valgfritt, ellers finnes brettet automatisk
SPEAKER_VOLUME=0.85     # 0.0-1.0, over ~0.9 kan forvrenge
# ElevenLabs (valgfritt; uten nøkkel brukes macOS say)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # tom = premade "Charlotte"; lim inn ID for en norsk stemme fra Voice Library
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_ENGINE=elevenlabs         # elevenlabs | say
