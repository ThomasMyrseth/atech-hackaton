ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-haiku-5-5
CALENDAR=demo            # demo | google
GOOGLE_CALENDAR_ID=      # for a normal Gmail calendar: your email address
GOOGLE_KEY_FILE=service-account.json
AUDIO_IN=device          # device | laptop
AUDIO_OUT=device         # device | laptop
TTS_VOICE=Samantha
TTS_RATE=190
MIC_THRESHOLD=2500
EVENING_TIME=22:30
# SERIAL_PORT=/dev/cu.usbmodem1101   # optional, otherwise the board is found automatically
SPEAKER_VOLUME=0.85     # 0.0-1.0, above ~0.9 can distort
# ElevenLabs: required for speech to text. Speech out uses macOS say without a key or with TTS_ENGINE=say.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # empty = premade "Charlotte"; paste an ID from the Voice Library for another voice
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_ENGINE=elevenlabs         # elevenlabs | say
